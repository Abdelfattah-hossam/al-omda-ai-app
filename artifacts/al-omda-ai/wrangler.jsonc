// Cloudflare Worker deployment configuration.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "al-omda-ai-app",
  "main": "../api-server/src/worker.ts",
  "compatibility_date": "2026-11-11",
  "vars": {
    "SUPABASE_URL": "https://rzznnrvlqumhymfmmpjk.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_5EaeynMc1bFY8lhe7CO0Cg_N2k5RMOZ",
    "OMDA_PRECISE_TEMPERATURE": "0.2"
  },
  "assets": {
    "directory": "./dist/public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Keyless Workers AI fallback for the chat/provider chain. On the Workers
  // Free plan this uses the included 10k neurons/day allocation and cannot
  // bill; no account ID or API token secret is required.
  "ai": {
    "binding": "AI"
  },
  // Stay well under the 200k/day Workers observability event budget on the free
  // plan: sample 10% of requests for logs and skip automatic per-request
  // invocation events. Exceptions are still captured; raise the rate temporarily
  // when debugging.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": false
    }
  },
  "previews": {}

}
